<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知权限：Android 13+ 需要运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 电池优化白名单：用于跳转“允许本应用忽略电池优化”设置页（侧载应用可声明） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 锁屏全屏强提醒（Android 10+ 普通权限） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 震动权限 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 精确闹钟权限（setAlarmClock 不需要，但保留以便后续按需回退，无害） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机自启后重新调度闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ClockInApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ClockInReminder">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddEditTaskActivity"
            android:exported="false" />
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <!-- 闹钟到点广播（应用内 PendingIntent 触发，无需导出） -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false" />
        <!-- 通知栏“标记完成”按钮广播 -->
        <receiver
            android:name=".receiver.MarkDoneReceiver"
            android:exported="false" />
        <!-- 通知栏“稍后提醒”按钮广播（联动点④） -->
        <receiver
            android:name=".receiver.SnoozeReceiver"
            android:exported="false" />
        <!-- 开机 / 应用更新后重新调度所有闹钟（系统广播，需要导出） -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
